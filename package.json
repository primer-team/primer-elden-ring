{
	"name": "primer-starter",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"prepare": "lefthook install",
		"db:up": "docker compose up -d postgres",
		"db:down": "docker compose down",
		"db:logs": "docker compose logs -f postgres",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@superbuilders/errors": "^3.0.2",
		"@superbuilders/primer-tives": "^3.7.0",
		"@superbuilders/slog": "^4.0.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"next": "^16.2.6",
		"postgres": "^3.4.9",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"tailwind-merge": "^3.5.0",
		"temml": "^0.13.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@tailwindcss/postcss": "^4.2.4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"drizzle-kit": "^0.31.10",
		"lefthook": "^2.1.6",
		"postcss": "^8.5.0",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"lefthook",
		"sharp",
		"unrs-resolver"
	]
}
