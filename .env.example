# Copy this file to .env.local and fill in your publishable key.
#   cp .env.example .env.local

# Your publishable key from primerlearn.dev → Keys (starts with `pk_`).
NEXT_PUBLIC_PRIMER_PUBLISHABLE_KEY=pk_replace_me

# Local Postgres (docker compose). Run `bun run db:up` to start.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=primer_elden_ring
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/primer_elden_ring

# OpenRouter powers manifest, image, and Seedance video generation.
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Primer Elden Ring Video Agent
OPENROUTER_MANIFEST_MODEL=google/gemini-3.1-pro-preview
OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0
